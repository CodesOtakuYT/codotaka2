#version 460
#extension GL_EXT_descriptor_heap : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_samplerless_texture_functions : require
#extension GL_EXT_buffer_reference : require

// Diagnostic image of one interpolated frame, 2W x H, 8-bit RGB (packed in uints):
// left = the interpolated frame, right = its error against the real frame (red, scaled)
// over the dimmed real frame.
layout(descriptor_heap) uniform texture2D textures[];
layout(buffer_reference, scalar) buffer Pixels { uint v[]; };

layout(push_constant, scalar) uniform Push {
    uint64_t out_pixels;
    uint truth, ours;
} pc;

layout(local_size_x = 16, local_size_y = 16) in;

vec3 enc(vec3 c) { return pow(clamp(c, 0.0, 1.0), vec3(1.0 / 2.2)); }

uint pack(vec3 c) {
    uvec3 u = uvec3(clamp(c, 0.0, 1.0) * 255.0 + 0.5);
    return u.r | (u.g << 8) | (u.b << 16);
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = textureSize(textures[nonuniformEXT(pc.truth)], 0);
    if (any(greaterThanEqual(p, size))) return;
    vec3 truth = enc(texelFetch(textures[nonuniformEXT(pc.truth)], p, 0).rgb);
    vec3 ours = enc(texelFetch(textures[nonuniformEXT(pc.ours)], p, 0).rgb);
    vec3 d = abs(truth - ours);
    float err = clamp(max(d.r, max(d.g, d.b)) * 4.0, 0.0, 1.0);
    vec3 heat = mix(vec3(dot(truth, vec3(0.3, 0.59, 0.11)) * 0.35), vec3(1.0, 0.15, 0.05), err);
    Pixels px = Pixels(pc.out_pixels);
    uint row = uint(p.y) * uint(size.x) * 2u;
    px.v[row + uint(p.x)] = pack(ours);
    px.v[row + uint(size.x) + uint(p.x)] = pack(heat);
}
